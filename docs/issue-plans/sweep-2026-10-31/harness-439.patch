diff --git a/tests/test_driver_core/test_run_probe.py b/tests/test_driver_core/test_run_probe.py
new file mode 100644
index 0000000..99475f6
--- /dev/null
+++ b/tests/test_driver_core/test_run_probe.py
@@ -0,0 +1,271 @@
+"""run_probe: a read-only action must not need write authority (#439).
+
+The vocabulary declares ``run_probe`` read-only, but the executor was
+registered nowhere, and the refusal blamed ``DRIVER_ALLOW_WRITE`` -- so a
+verifier, whose correct posture is writes off and no key, could not run
+the deterministic checks that are its whole job. These tests pin the
+fix: declared probes run with writes off, undeclared names refuse, write
+actions still refuse, and the refusal for a read-only action no longer
+names the write gate.
+
+Hermetic: process execution is a recording fake at the ``osal`` seam,
+except one end-to-end case that runs the interpreter this suite is
+running on (``sys.executable``) -- never a bare ``python``, which a host
+may not have.
+"""
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+from driver_core import osal
+from driver_core.actions import DEFAULT_VOCABULARY
+from driver_core.audit import KIND_ACTION, MemoryAuditLog
+from driver_core.config import ConfigError, Settings, load_settings
+from driver_core.driver import Driver
+from driver_core.errors import ExecutorError
+from driver_core.executor import Consent, Executor
+from driver_core.executor_registry import (
+    WRITE_EXECUTORS, build_driver_registry, executability,
+)
+from driver_core.osal import ProcessResult
+from driver_core.server import Service
+from driver_core.wiring import configured_probes
+
+PROBES = {"health_check": ("probe-bin", "--check")}
+
+
+def _executor(*, allow_write=False, probes=PROBES, audit=None,
+              dry_run=False):
+    return Executor(
+        vocabulary=DEFAULT_VOCABULARY,
+        registry=build_driver_registry(allow_write=allow_write,
+                                       probes=probes),
+        audit=audit or MemoryAuditLog(), dry_run=dry_run)
+
+
+class _FakeRun:
+    """A recording ``osal.run`` double returning one canned result."""
+
+    def __init__(self, result):
+        self.result = result
+        self.calls = []
+
+    def __call__(self, argv, **kwargs):
+        self.calls.append(list(argv))
+        return self.result
+
+
+def _ok_result(stdout="all good\n", stderr=""):
+    return ProcessResult(0, True, stdout, stderr, "")
+
+
+class ProbeExecutionTests(unittest.TestCase):
+
+    def test_probe_runs_with_writes_off_and_is_recorded(self):
+        audit = MemoryAuditLog()
+        fake = _FakeRun(_ok_result())
+        with mock.patch.object(osal, "run", fake):
+            result = _executor(audit=audit).execute(
+                "run_probe", {"command": "health_check"})
+        self.assertTrue(result.ok, result.detail)
+        self.assertEqual(result.output["command"], "health_check")
+        self.assertEqual(result.output["argv"], ["probe-bin", "--check"])
+        self.assertEqual(result.output["exit_code"], 0)
+        self.assertEqual(result.output["stdout"], "all good\n")
+        self.assertEqual(result.output["stderr"], "")
+        # The argv that ran is the declared argv, unchanged.
+        self.assertEqual(fake.calls, [["probe-bin", "--check"]])
+        # The execution landed in the audit chain like any other action.
+        actions = [r for r in audit.records
+                   if r.get("kind") == KIND_ACTION]
+        self.assertEqual(len(actions), 1)
+        self.assertEqual(actions[0]["action"], "run_probe")
+        self.assertTrue(actions[0]["ok"])
+
+    def test_probe_runs_unkeyed_through_a_driver(self):
+        settings = load_settings(
+            env={"DRIVER_PROBES": "health_check=probe-bin --check"})
+        self.assertFalse(settings.keyed)
+        self.assertFalse(settings.allow_write)
+        driver = Driver(settings=settings, audit=MemoryAuditLog())
+        fake = _FakeRun(_ok_result())
+        with mock.patch.object(osal, "run", fake):
+            result = driver.executor.execute(
+                "run_probe", {"command": "health_check"})
+        self.assertTrue(result.ok, result.detail)
+        self.assertEqual(fake.calls, [["probe-bin", "--check"]])
+
+    def test_undeclared_command_shapes_are_refused_and_nothing_runs(self):
+        fake = _FakeRun(_ok_result())
+        executor = _executor()
+        with mock.patch.object(osal, "run", fake):
+            for name in ("rm -rf /", "health_check; rm -rf /", "health",
+                         "health_check --force"):
+                with self.subTest(name=name):
+                    result = executor.execute(
+                        "run_probe", {"command": name})
+                    self.assertFalse(result.ok)
+                    self.assertIn("not a declared read-only probe",
+                                  result.detail)
+        self.assertEqual(fake.calls, [])
+
+    def test_non_zero_exit_is_an_answer_not_a_refusal(self):
+        fake = _FakeRun(ProcessResult(3, False, "", "check failed", ""))
+        with mock.patch.object(osal, "run", fake):
+            result = _executor().execute(
+                "run_probe", {"command": "health_check"})
+        self.assertTrue(result.ok, result.detail)
+        self.assertEqual(result.output["exit_code"], 3)
+        self.assertEqual(result.output["stderr"], "check failed")
+
+    def test_a_probe_that_cannot_start_is_refused(self):
+        fake = _FakeRun(ProcessResult(0, False, "", "",
+                                      "not found: probe-bin",
+                                      reason="not_found"))
+        with mock.patch.object(osal, "run", fake):
+            result = _executor().execute(
+                "run_probe", {"command": "health_check"})
+        self.assertFalse(result.ok)
+        self.assertIn("could not run", result.detail)
+        self.assertIn("not found: probe-bin", result.detail)
+
+    def test_probe_does_not_run_in_dry_run(self):
+        fake = _FakeRun(_ok_result())
+        with mock.patch.object(osal, "run", fake):
+            result = _executor(dry_run=True).execute(
+                "run_probe", {"command": "health_check"})
+        self.assertTrue(result.ok)
+        self.assertTrue(result.dry_run)
+        self.assertEqual(fake.calls, [])
+
+    def test_a_real_probe_runs_the_declared_argv_end_to_end(self):
+        executor = _executor(probes={"interp": (
+            sys.executable, "-c",
+            "import sys; print('probe-ran'); sys.exit(3)")})
+        result = executor.execute("run_probe", {"command": "interp"})
+        self.assertTrue(result.ok, result.detail)
+        self.assertIn("probe-ran", result.output["stdout"])
+        self.assertEqual(result.output["exit_code"], 3)
+
+    def test_a_string_argv_declaration_is_refused_at_build_time(self):
+        with self.assertRaises(ExecutorError):
+            build_driver_registry(probes={"bad": "probe-bin --check"})
+        with self.assertRaises(ExecutorError):
+            build_driver_registry(probes={"bad": ()})
+
+
+class WriteGateTests(unittest.TestCase):
+
+    def test_mutating_actions_still_refuse_with_writes_off(self):
+        executor = _executor()
+        # Resolved first: consent is checked against the normalised
+        # params, so the grant must name the resolved path for execution
+        # to reach the registry refusal this test is about.
+        target = osal.resolve_path("probe-gate-target.txt")
+        cases = (
+            ("write_file", {"path": target, "content": "y"}),
+            ("delete_file", {"path": target}),
+        )
+        for name, params in cases:
+            with self.subTest(name=name):
+                with self.assertRaises(ExecutorError) as ctx:
+                    executor.execute(name, params,
+                                     consent=Consent(True, name, params))
+                self.assertIn("DRIVER_ALLOW_WRITE", str(ctx.exception))
+
+    def test_write_on_behaviour_is_unchanged(self):
+        registry = build_driver_registry(allow_write=True, probes=PROBES)
+        for name in WRITE_EXECUTORS:
+            self.assertIn(name, registry.names())
+        self.assertIn("run_probe", registry.names())
+        executor = Executor(vocabulary=DEFAULT_VOCABULARY,
+                            registry=registry, audit=MemoryAuditLog())
+        with tempfile.TemporaryDirectory() as tmp:
+            path = osal.resolve_path(str(Path(tmp) / "out.txt"))
+            params = {"path": path, "content": "hello"}
+            result = executor.execute(
+                "write_file", params,
+                consent=Consent(True, "write_file", params))
+            self.assertTrue(result.ok, result.detail)
+            self.assertEqual(Path(path).read_text(encoding="utf-8"),
+                             "hello")
+        fake = _FakeRun(_ok_result())
+        with mock.patch.object(osal, "run", fake):
+            result = executor.execute(
+                "run_probe", {"command": "health_check"})
+        self.assertTrue(result.ok, result.detail)
+
