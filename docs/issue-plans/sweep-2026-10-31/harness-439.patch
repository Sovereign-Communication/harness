+class VocabularyReasonTests(unittest.TestCase):
+    """The vocabulary output must not blame the write gate for read-only."""
+
+    def _by_name(self, driver):
+        view = Service(driver, token="t").handle(
+            "vocabulary", {})["body"]
+        return {a["name"]: a for a in view["vocabulary"]["actions"]}
+
+    def test_declared_probe_is_executable_with_writes_off(self):
+        settings = load_settings(
+            env={}, allow_write=False,
+            probes=(("health_check", "probe-bin --check"),))
+        actions = self._by_name(
+            Driver(settings=settings, audit=MemoryAuditLog()))
+        self.assertTrue(actions["run_probe"]["executable"])
+        self.assertEqual(actions["run_probe"]["needs"], [])
+
+    def test_read_only_refusals_do_not_name_the_write_gate(self):
+        settings = load_settings(env={}, allow_write=False)
+        actions = self._by_name(
+            Driver(settings=settings, audit=MemoryAuditLog()))
+        for name in ("run_probe", "call_read_tool", "read_dom"):
+            with self.subTest(name=name):
+                self.assertFalse(actions[name]["executable"])
+                self.assertNotIn("DRIVER_ALLOW_WRITE",
+                                 " ".join(actions[name]["needs"]))
+        self.assertIn("DRIVER_ALLOW_WRITE",
+                      " ".join(actions["click"]["needs"]))
+
+    def test_executability_helper_scopes_the_note_the_same_way(self):
+        registry = build_driver_registry(allow_write=False)
+        ok, needs = executability(
+            DEFAULT_VOCABULARY.resolve("run_probe"), registry)
+        self.assertFalse(ok)
+        self.assertNotIn("DRIVER_ALLOW_WRITE", " ".join(needs))
+        ok, needs = executability(
+            DEFAULT_VOCABULARY.resolve("click"), registry)
+        self.assertFalse(ok)
+        self.assertIn("DRIVER_ALLOW_WRITE", " ".join(needs))
+
