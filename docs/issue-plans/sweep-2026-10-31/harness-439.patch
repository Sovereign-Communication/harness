+def _freeze_probes(probes):
+    """Validate and freeze a probe declaration: ``{name: argv tuple}``.
+
+    A declaration is operator-supplied configuration, and a malformed one
+    is refused at build time rather than at first use. An argv given as a
+    single string is the dangerous case: any runner that accepted it
+    would hand it to a shell, which is exactly what
+    :func:`driver_core.osal.run` exists to prevent, so the string form
+    is an error here and not a convenience to be split on the caller's
+    behalf.
+    """
+    frozen = {}
+    for name, argv in dict(probes or {}).items():
+        if not isinstance(name, str) or not name.strip():
+            raise ExecutorError("a probe name must be a non-empty string")
+        if isinstance(argv, str) or not isinstance(argv, (list, tuple)):
+            raise ExecutorError(
+                f"probe {name!r}: argv must be a sequence of strings, not "
+                f"{type(argv).__name__}; a single string would be handed "
+                f"to a shell")
+        argv = tuple(argv)
+        if not argv or not all(isinstance(a, str) and a for a in argv):
+            raise ExecutorError(
+                f"probe {name!r}: argv must be a non-empty sequence of "
+                f"non-empty strings")
+        frozen[name] = argv
+    return frozen
+
