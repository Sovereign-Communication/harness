+class ProbeDeclarationTests(unittest.TestCase):
+
+    def test_env_declaration_parses(self):
+        settings = load_settings(
+            env={"DRIVER_PROBES": "a=cmd --flag; b=other -x"})
+        self.assertEqual(settings.probes,
+                         (("a", "cmd --flag"), ("b", "other -x")))
+
+    def test_malformed_env_declaration_raises(self):
+        with self.assertRaises(ConfigError):
+            load_settings(env={"DRIVER_PROBES": "noequals"})
+
+    def test_unusable_declarations_raise_at_settings_build(self):
+        for probes in ((("bad name", "cmd"),), (("ok", "  "),),
+                       (("dup", "a"), ("dup", "b"))):
+            with self.subTest(probes=probes):
+                with self.assertRaises(ConfigError):
+                    Settings(probes=probes)
+
+    def test_configured_probes_split_like_declared_commands(self):
+        settings = load_settings(
+            env={}, probes=(("win", r'"C:\Program Files\tool.exe"'
+                             " --check"),))
+        self.assertEqual(
+            configured_probes(settings),
+            {"win": (r"C:\Program Files\tool.exe", "--check")})
