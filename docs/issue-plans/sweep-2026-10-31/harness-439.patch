+            f"command {name!r} is not a declared read-only probe; only "
+            f"a declared name may run (declared: {sorted(probes)}; "
+            f"declare probes with DRIVER_PROBES or the registry builder)")
+    result = osal.run(list(argv))
+    if result.reason:
