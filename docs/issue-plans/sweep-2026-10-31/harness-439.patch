+def _probe_name(name):
+    """Whether ``name`` can name a declared read-only probe.
+
+    Conservative on purpose: a probe name is how a caller refers to a
+    declared command, so it is a label, not a string with structure --
+    no spaces, no separators, nothing a shell or a path could read
+    meaning into.
+    """
+    return (isinstance(name, str) and bool(name)
+            and all(c.isalnum() or c in "-_" for c in name))
+
+
+def _env_probes(env):
+    """Parse ``DRIVER_PROBES``: ``name=command`` entries separated by ';'.
+
+    A malformed entry is a configuration fault and raises rather than
+    being skipped: an operator who declared a probe that silently does
+    not exist has a verifier that refuses for a reason nobody can see.
+    Name and command are validated when the settings are built.
+    """
+    raw = env.get(ENV_PREFIX + "PROBES", "")
+    pairs = []
+    for entry in raw.split(";"):
+        entry = entry.strip()
+        if not entry:
+            continue
+        name, sep, command = entry.partition("=")
+        if not sep:
+            raise ConfigError(
+                f"{ENV_PREFIX}PROBES entry {entry!r} is not name=command")
+        pairs.append((name.strip(), command.strip()))
+    return tuple(pairs)
+
